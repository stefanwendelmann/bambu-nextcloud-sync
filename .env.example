# Copy to .env and fill in the five REPLACE_ME values. Never commit .env.

# --- Printer (source, read-only) ---------------------------------------------
# Host name or IP address of the printer in your local network.
BAMBU_HOST=REPLACE_ME
BAMBU_PORT=990
BAMBU_USERNAME=bblp
# The printer's LAN access code (shown on the printer), not your Bambu account password.
BAMBU_ACCESS_CODE=REPLACE_ME
BAMBU_SOURCE_PATH=/
# Bambu printers present a self-signed certificate that cannot be verified.
# true accepts it for the printer connection only; use it on a trusted network.
BAMBU_TLS_INSECURE=false

# --- Nextcloud (destination) --------------------------------------------------
# The WebDAV address of your files, not the address you open in the browser:
# https://nextcloud.example.com/remote.php/dav/files/USERNAME/
NEXTCLOUD_WEBDAV_URL=REPLACE_ME
NEXTCLOUD_USERNAME=REPLACE_ME
# An app password: Nextcloud > Personal settings > Security > Devices & sessions.
NEXTCLOUD_APP_PASSWORD=REPLACE_ME
# Folder inside your Nextcloud files. It is created when needed.
NEXTCLOUD_FOLDER=3D Druck/Bambu P2S/Projekte
# Optional: PEM file with a private CA for the Nextcloud server (mount it into the container).
NEXTCLOUD_CA_CERT_FILE=

# --- Behaviour -----------------------------------------------------------------
# root: .3mf files directly in BAMBU_SOURCE_PATH. recursive: sub folders too.
SCAN_MODE=root
# version: update in place, only if the Nextcloud Versions app keeps the old file.
# overwrite: update in place. skip: never touch an existing file.
CONFLICT_MODE=version
# Seconds between sync runs, and between the two listings that prove a file is complete.
SYNC_INTERVAL=300
STABILITY_CHECK_INTERVAL=30
# true: only report what would be transferred.
DRY_RUN=false
# true: run one cycle and exit (exit code 0 = no errors).
RUN_ONCE=false
LOG_LEVEL=info
TZ=Europe/Berlin

# --- Reserved: mirror mode and metadata extraction are not implemented yet -----
# The service refuses to start with SYNC_MODE=mirror or EXTRACT_METADATA=true.
SYNC_MODE=archive
MIRROR_MODE=managed
EXTRACT_METADATA=false
MAX_DELETE_COUNT=10
MAX_DELETE_PERCENT=20
ALLOW_EMPTY_SOURCE_MIRROR=false
